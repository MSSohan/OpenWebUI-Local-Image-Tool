# Copy this file to .env and replace both example values with random secrets.
# PowerShell: python -c "import secrets; print(secrets.token_hex(32))"
WEBUI_SECRET_KEY=replace_with_a_random_64_character_hex_secret
IMAGE_TOOL_API_TOKEN=replace_with_a_different_random_64_character_hex_secret

# ComfyUI runs on the Windows host in CPU mode.
COMFYUI_URL=http://host.docker.internal:8188
COMFYUI_CHECKPOINT=sd_turbo.safetensors
COMFYUI_TIMEOUT_SECONDS=900
PUBLIC_IMAGE_BASE_URL=http://localhost:8001
